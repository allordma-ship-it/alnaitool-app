{
  "name": "aurastream-web-backend",
  "version": "1.0.0",
  "description": "AuraStream IPTV cloud backend: device pairing, licensing and remote playlist management (Fastify).",
  "type": "module",
  "main": "server.js",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server.js",
    "migrate": "node --disable-warning=ExperimentalWarning db/migrate.js",
    "test": "node --disable-warning=ExperimentalWarning --test 'test/**/*.test.js'"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/static": "^8.0.0",
    "fastify": "^5.1.0",
    "pg": "^8.13.0"
  }
}
