# --- Server ---
PORT=8080
HOST=0.0.0.0
NODE_ENV=development
# Set to true when running behind a reverse proxy / load balancer (needed for correct client IPs in rate limiting)
TRUST_PROXY=false

# Public URL of the web portal (encoded into the TV's QR code)
PUBLIC_PORTAL_URL=http://localhost:8080

# --- Database ---
# PostgreSQL (production). When unset, a local SQLite file is used (development only).
# DATABASE_URL=postgres://aura:aura@localhost:5432/aurastream
SQLITE_PATH=./data/dev.sqlite

# --- Security ---
# REQUIRED in production: long random string (>= 32 chars). Signs portal session tokens.
APP_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# Optional: 32-byte key (hex or base64) for AES-256-GCM encryption of Xtream credentials at rest.
# Derived from APP_SECRET via HKDF when omitted.
# CREDENTIALS_KEY=
# Optional: enables /api/v1/admin/* when set.
# ADMIN_TOKEN=
# Comma separated list of allowed CORS origins for the API (portal is same-origin by default)
# CORS_ORIGINS=

# --- Business rules ---
TRIAL_DAYS=7
MAX_UPLOAD_MB=40
MAX_PLAYLISTS_PER_DEVICE=10
PORTAL_TOKEN_TTL_MIN=30
