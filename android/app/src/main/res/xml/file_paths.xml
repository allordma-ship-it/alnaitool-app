<?xml version="1.0" encoding="utf-8"?>
<!-- Folders other apps may receive files from, through ${applicationId}.fileprovider. Only what Notiva actually hands out. -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- the share sheet: exported PDFs, pictures, text and shared backups are written to the cache first (Directory.Cache) -->
    <cache-path name="my_cache_images" path="." />
    <!-- scanner photo: Capacitor's file chooser has the camera app save it to getExternalFilesDir(Pictures) -->
    <external-files-path name="my_images" path="Pictures/" />
</paths>
