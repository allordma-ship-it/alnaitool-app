# Wanees (ونيس) — carpooling for Syria.

# --- Runtime ------------------------------------------------------------------
APP_ENV=development
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-64-character-hex-string-0000000000000000
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
AUTO_MIGRATE=true
CORS_ALLOWED_ORIGINS=*
# Set to true only behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
RATE_LIMIT_PER_MINUTE=120

# --- Market -------------------------------------------------------------------
COUNTRY=SY
# New Syrian pound (since 1 Jan 2026, 1 new = 100 old). Amounts are stored in
# minor units (piastres): 1 SYP = 100.
DEFAULT_CURRENCY=SYP
DEFAULT_TIMEZONE=Asia/Damascus

# --- Pricing (minor units of DEFAULT_CURRENCY) ----------------------------------
# Reference cost-sharing price per seat and kilometre: 250 = 2.50 SYP/km
# (Damascus-Aleppo ~ 900 SYP per seat). Adjust to current fuel prices.
PRICE_CENTS_PER_KM=250
# Prices are rounded to this step: 5000 = 50 SYP.
PRICE_STEP_MINOR=5000
# Lowest price for any seat or partial segment: 10000 = 100 SYP.
MIN_SEAT_PRICE_MINOR=10000

# --- Datastores (compose wires DATABASE_URL / REDIS_URL for the api service) ---
POSTGRES_USER=wanees
POSTGRES_PASSWORD=wanees
POSTGRES_DB=wanees
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8080
# Used when running the API outside docker (make run):
DATABASE_URL=postgres://wanees:wanees@localhost:5432/wanees?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# --- Routing (osrm | valhalla) -----------------------------------------------
ROUTING_PROVIDER=osrm
ROUTING_BASE_URL=http://osrm:5000
ROUTING_TIMEOUT=10s
OSRM_PORT=5000
OSRM_PBF_URL=https://download.geofabrik.de/asia/syria-latest.osm.pbf

# --- Geocoding (Photon / OpenStreetMap) ---------------------------------------
GEOCODER_BASE_URL=https://photon.komoot.io
GEOCODER_USER_AGENT=Wanees/1.0 (contact: ops@example.com)
# Restrict place search to Syria: minLon,minLat,maxLon,maxLat (empty = worldwide).
GEOCODER_BBOX=35.5,32.3,42.4,37.4

# --- Payments (cash | stripe | simulated) ------------------------------------
# Card acquiring (Stripe) is not available in Syria: passengers pay the driver
# in cash. Platform fees must be 0 with cash.
PAYMENT_PROVIDER=cash
PLATFORM_FEE_BPS=0
PLATFORM_FEE_FIXED_CENTS=0
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_RETURN_URL=wanees://payouts/return
STRIPE_CONNECT_REFRESH_URL=wanees://payouts/refresh
LATE_CANCEL_WINDOW=24h
LATE_CANCEL_PERCENT=50

# --- Background worker --------------------------------------------------------
WORKER_INTERVAL=1m
PAYMENT_PENDING_TTL=30m
REQUEST_RESPONSE_TTL=24h
AUTO_COMPLETE_AFTER=24h
