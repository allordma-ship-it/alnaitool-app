# --- Runtime ------------------------------------------------------------------
APP_ENV=development
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-64-character-hex-string-0000000000000000
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
AUTO_MIGRATE=true
CORS_ALLOWED_ORIGINS=*
# Set to true only behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
RATE_LIMIT_PER_MINUTE=120

# --- Datastores (compose wires DATABASE_URL / REDIS_URL for the api service) ---
POSTGRES_USER=waypoint
POSTGRES_PASSWORD=waypoint
POSTGRES_DB=waypoint
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8080
# Used when running the API outside docker (make run):
DATABASE_URL=postgres://waypoint:waypoint@localhost:5432/waypoint?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# --- Routing (osrm | valhalla) -----------------------------------------------
ROUTING_PROVIDER=osrm
ROUTING_BASE_URL=http://osrm:5000
ROUTING_TIMEOUT=10s
OSRM_PORT=5000
# Any Geofabrik extract works; larger regions need more RAM to preprocess.
OSRM_PBF_URL=https://download.geofabrik.de/europe/germany/baden-wuerttemberg-latest.osm.pbf

# --- Geocoding (Photon / OpenStreetMap) ---------------------------------------
GEOCODER_BASE_URL=https://photon.komoot.io
GEOCODER_USER_AGENT=WayPoint/1.0 (contact: ops@example.com)

# --- Payments (simulated | stripe) -------------------------------------------
PAYMENT_PROVIDER=simulated
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_RETURN_URL=waypoint://payouts/return
STRIPE_CONNECT_REFRESH_URL=waypoint://payouts/refresh

# --- Marketplace economics ----------------------------------------------------
PLATFORM_FEE_BPS=1000
PLATFORM_FEE_FIXED_CENTS=50
PRICE_CENTS_PER_KM=8
LATE_CANCEL_WINDOW=24h
LATE_CANCEL_PERCENT=50

# --- Background worker --------------------------------------------------------
WORKER_INTERVAL=1m
PAYMENT_PENDING_TTL=30m
REQUEST_RESPONSE_TTL=24h
AUTO_COMPLETE_AFTER=24h
